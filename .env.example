# CCB API — environment template.
#
# Copy this file to `.env` (a developer machine) or to `.env.<name>` (a server; the process picks the file
# with the APP_ENV variable — see "Which file is read" below) and fill in REAL values. Never commit the
# filled-in file: every `.env*` file except this template is git-ignored, and this template must only ever
# contain placeholders. Secrets are listed by NAME only here; generate each one fresh per environment —
# DEV, local and any other environment must NEVER share a secret or a database password.
#
# Which file is read: the process variable APP_ENV (set in the shell / pm2 / systemd, not in this file)
#   unset or "local" -> .env        "dev" -> .env.dev        any other name -> .env.<name> (must exist)
#
# The application refuses to start (and says which KEY is wrong, never the value) when JWT_SECRET is
# missing, shorter than 32 characters or a placeholder, or — in a production-like environment — when a
# required secret is still a placeholder, DB_USERNAME is `root`, or DB_SYNCHRONIZE is enabled.

# ── Runtime ──────────────────────────────────────────────────────────────────────────────────────
# FAIL-SAFE: only "development" and "test" relax anything. Any other value — "production", "dev",
# "staging", a typo, or no value at all — is treated as production-like (schema auto-sync, SQL logging and
# Swagger are off, cookies are Secure, HSTS is sent). Use "development" on a developer machine only.
# A CUSTOMER installation sets NODE_ENV=production (any value other than "development" or "test" is production-like, so the example
# administrator address is refused, no sample business data is loaded and no schema auto-sync runs).
NODE_ENV=development
PORT=4000
API_PREFIX=api
# Node.js: CCB is built and tested on the LTS lines listed in package.json "engines" (22, 24). Starting on a version past its end of life is logged as a
# warning; set ENFORCE_SUPPORTED_NODE=true to refuse to start instead (docs/OPERATIONS.md, "Node.js").
# ENFORCE_SUPPORTED_NODE=false
# Graceful shutdown (SIGTERM / SIGINT): readiness (GET /health/ready) answers 503 first, the process waits SHUTDOWN_DRAIN_MS so a load balancer can stop
# routing to it (0 = no wait), closes everything, and is forced to exit after SHUTDOWN_TIMEOUT_MS if the close hangs.
# SHUTDOWN_DRAIN_MS=0
# SHUTDOWN_TIMEOUT_MS=15000
# GET /health/ready answers 503 while a database migration is pending. Set true only if a rolling upgrade must keep an instance in rotation meanwhile.
# HEALTH_IGNORE_PENDING_MIGRATIONS=false

# ── Database (MySQL) ─────────────────────────────────────────────────────────────────────────────
# Use a least-privilege application account (data changes only), never root. scripts/db/provision-db-users.sql
# creates one account for the running API and, separately, a schema-change account for migrations.
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=ccb_app
DB_PASSWORD=__SET_DB_PASSWORD__
DB_DATABASE=ccb

# Schema auto-sync and SQL logging exist ONLY on a developer machine (NODE_ENV=development, on by default
# there; set false to turn them off). Everywhere else they are off, and DB_SYNCHRONIZE=true is a startup error.
# DB_SYNCHRONIZE=false
# DB_LOGGING=false
# Run pending migrations when the API boots (default true). Set false where the runtime account is
# DML-only and a privileged account applies migrations with `npm run migration:run`.
# DB_MIGRATIONS_RUN=false
# The migration CLI (npm run migration:run / migration:revert) uses these instead when set, so the running
# API never needs schema-change rights. Falls back to DB_USERNAME / DB_PASSWORD when unset.
# DB_MIGRATION_USERNAME=ccb_migrator
# DB_MIGRATION_PASSWORD=__SET_MIGRATION_PASSWORD__

# ── Redis ────────────────────────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
ATTRIBUTE_CACHE_TTL_SECONDS=300

# ── Authentication ───────────────────────────────────────────────────────────────────────────────
# Signing key for every access token (staff and customer). At least 32 characters of random data, unique
# per environment:   openssl rand -base64 48
JWT_SECRET=__SET_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS__
# Still required, but only the JwtModule's default option: every token is signed with the SESSION TIMEOUT instead (see
# SESSION_TIMEOUT_MINUTES below), so changing this does not change how long an access token lives.
JWT_EXPIRES_IN=15m
# How long a sign-in stays refreshable. Sliding: every refresh issues a token with a fresh full lifetime. Format: 30s, 15m, 1h, 7d.
REFRESH_TOKEN_EXPIRES_IN=7d
# Session timeout in minutes (30–1440; built-in default 30). Only the value a fresh database's session-timeout attribute is first seeded from
# (and the fallback while that attribute is unset); afterwards a SUPER_ADMIN changes it under Settings > System Attributes.
# SESSION_TIMEOUT_MINUTES=30
# The same, for a sign-in with "Remember me" ticked: a PERSISTENT session (its refresh cookie survives the browser being closed).
# Without the tick the cookie is a browser-session cookie and REFRESH_TOKEN_EXPIRES_IN applies. Never shorter than
# REFRESH_TOKEN_EXPIRES_IN. The access token is the same either way. Default 30d when unset.
# REFRESH_TOKEN_REMEMBER_ME_EXPIRES_IN=30d

# Refresh-token cookie (HttpOnly, scoped to /<API_PREFIX>/v1/auth). Secure defaults to true when
# NODE_ENV=production; SameSite defaults to lax. A cookie only reaches the API when the web app and the API
# are SAME-SITE (same registrable domain or one reverse proxy origin); for a cross-site deployment use HTTPS
# with COOKIE_SAMESITE=none (always Secure). Plain-http cross-origin setups cannot carry the cookie.
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=true
# COOKIE_DOMAIN=
# REFRESH_COOKIE_NAME=ccb_rt
# Compatibility only: also return the refresh token in the JSON body (older clients). Leave unset/false.
# AUTH_REFRESH_IN_BODY=false

# Brute-force protection on sign-in, counted in fixed windows that start at the first failure (all three also guard the second-factor and
# password-recovery steps, each with its own counters):
#   - per ACCOUNT AND CLIENT: one client IP guessing one account is refused for that account at LOGIN_MAX_FAILED_PER_ACCOUNT failures. Another client —
#     the account's owner — is NOT affected, so a stranger cannot lock the owner out by failing on purpose;
#   - per client IP: LOGIN_MAX_FAILED_PER_IP failures against any accounts lock that IP for everybody it tried;
#   - per ACCOUNT across all clients: at LOGIN_MAX_FAILED_PER_ACCOUNT_ANY_CLIENT failures the account is in PROTECTED mode — only a client that signed in
#     to it within LOGIN_KNOWN_CLIENT_DAYS still gets through; strangers are refused until the window ends.
# A lock never needs a restart: a signed-in administrator uses "Unlock sign-in" on the user's Manage sign-in access screen, and on the server
# `npm run maintenance:unlock-signin` clears it (docs/OPERATIONS.md, "Sign-in lock-out").
# LOGIN_MAX_FAILED_PER_ACCOUNT=10
# LOGIN_MAX_FAILED_PER_ACCOUNT_ANY_CLIENT=50
# LOGIN_MAX_FAILED_PER_IP=20
# LOGIN_LOCK_MINUTES=15
# LOGIN_KNOWN_CLIENT_DAYS=30
# Request-rate limits per client IP: a generous default for every route, a strict one for sign-in, token
# refresh, customer activation, password change and the admin credential actions.
# THROTTLE_LIMIT=600
# THROTTLE_TTL_SECONDS=60
# THROTTLE_AUTH_LIMIT=10
# THROTTLE_AUTH_TTL_SECONDS=60

# ── HTTP surface ─────────────────────────────────────────────────────────────────────────────────
# Browser origins allowed to call the API, comma-separated, no wildcard (a "*" is rejected at startup).
# Nothing is allowed unless listed — except on a developer machine, where http://localhost:3000 and
# http://127.0.0.1:3000 are allowed by default. List every web origin of THIS environment explicitly.
# CORS_ORIGINS=https://app.example.com
# How many reverse-proxy hops to trust for X-Forwarded-For: a number (1 = one proxy in front of the API), "loopback", or a list of IP addresses /
# CIDR ranges ("10.0.0.0/8, 192.168.1.5"). "true" (trust everybody) is refused at start-up: it would let any client choose the address it is rate
# limited and locked out under.
# Unset = trust nobody, which is correct when clients reach the API directly. BEHIND a reverse proxy it MUST be set: otherwise every user arrives from
# the proxy's address, the sign-in lock-out and the request throttle treat the whole organisation as one client, and the sign-in history records the
# proxy. The API logs a warning when it sees X-Forwarded-For while this is unset.
# TRUST_PROXY=1
# Swagger UI and the OpenAPI JSON list every route: on by default on a developer machine only. Enable
# elsewhere deliberately.
# SWAGGER_ENABLED=false

# ── First-run administrator (only used when the database has never held a user) ──────────────────
# The installation's ONE default SUPER_ADMIN — the customer's own highest administrator. DEFAULT_ADMIN_PASSWORD is
# mandatory on a fresh database (unless BOOTSTRAP_SEED_ADMIN=false) and must meet the password policy: at least 12
# characters and at most 72 bytes (UTF-8; bcrypt ignores anything longer), at least 3 of {uppercase, lowercase,
# number, symbol}, not one repeated character. It is only a TEMPORARY password: the account is created with "must
# change password at first sign-in" set, so its holder chooses their own. REMOVE the value from the file once the
# first sign-in is done (a production start warns while it is still here).
# In production DEFAULT_ADMIN_EMAIL must be the REAL address of the person who will administer this installation —
# the example address below is refused outside a developer machine.
# BOOTSTRAP_SEED_ADMIN=false creates the role and NO account (no password in any file) — in that case DELETE the
# DEFAULT_ADMIN_PASSWORD line below too (a production start refuses the placeholder); then run on the server:
#   npm run maintenance:super-admin -- --email you@customer.example --name "Your Name" --apply
# BOOTSTRAP_SEED_ADMIN=false
DEFAULT_ADMIN_NAME=System Administrator
DEFAULT_ADMIN_EMAIL=admin@ccb.local
DEFAULT_ADMIN_PASSWORD=__SET_A_STRONG_INITIAL_PASSWORD__

# ── Sample (demo) business data ───────────────────────────────────────────────────────────────────
# A fresh database's first start can also load one estate's sample Community / Property / Unit data. A customer installation must NOT
# start with it, so it is never loaded in production by default. Set BOOTSTRAP_SEED_DEMO_DATA=true ONLY for a demo or training
# installation; "false" never loads it. Unset: loaded on a developer machine (NODE_ENV=development/test), never in production.
# BOOTSTRAP_SEED_DEMO_DATA=false

# ── Customer portal / activation ─────────────────────────────────────────────────────────────────
# Base URL of the customer-facing web app, used to build activation links.
CUSTOMER_PORTAL_URL=http://localhost:3000
ACTIVATION_TOKEN_EXPIRY=48h

# ── Account invitations / e-mail templates (switched on only after the approved activation — docs/INVITATIONS_AND_EMAIL_TEMPLATES.md) ──
# Public address of the web app that staff invitation links point at. Optional: when unset, CUSTOMER_PORTAL_URL is used (one web
# application serves both). Invitation links are built from these settings only — never from the request — and must be https in production.
# STAFF_PORTAL_URL=http://localhost:3000
# Company name shown in the header and footer of every e-mail until an administrator saves one in Email Templates > Settings.
# COMPANY_NAME=

# ── Integrations (third-party credentials: issue per environment, never reuse another environment's) ─
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
SFTP_PASSWORD=
SFTP_REMOTE_PATH=
SFTP_CRON_ENABLED=false

SSO_AUTHORIZATION_URL=
SSO_TOKEN_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_CALLBACK_URL=

CONVERSEZEN_BASE_URL=
CONVERSEZEN_API_KEY=
CONVERSEZEN_AGENT_EMIRATES_ID=
CONVERSEZEN_AGENT_PASSPORT=
CONVERSEZEN_AGENT_TRN=
CONVERSEZEN_AGENT_TRADE_LICENSE=
CONVERSEZEN_AGENT_RAG=
CONVERSEZEN_AGENT_TITLE_DEED=
CONVERSEZEN_AGENT_TENANCY_CONTRACT=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
