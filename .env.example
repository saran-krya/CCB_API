# CCB API — environment template.
#
# Copy this file to `.env` (a developer machine) or to `.env.<name>` (a server; the process picks the file
# with the APP_ENV variable — see "Which file is read" below) and fill in REAL values. Never commit the
# filled-in file: every `.env*` file except this template is git-ignored, and this template must only ever
# contain placeholders. Secrets are listed by NAME only here; generate each one fresh per environment —
# DEV, local and any other environment must NEVER share a secret or a database password.
#
# Which file is read: the process variable APP_ENV (set in the shell / pm2 / systemd, not in this file)
#   unset or "local" -> .env        "dev" -> .env.dev        any other name -> .env.<name> (must exist)
#
# The application refuses to start (and says which KEY is wrong, never the value) when JWT_SECRET is
# missing, shorter than 32 characters or a placeholder, or — in a production-like environment — when a
# required secret is still a placeholder, DB_USERNAME is `root`, or DB_SYNCHRONIZE is enabled.

# ── Runtime ──────────────────────────────────────────────────────────────────────────────────────
# FAIL-SAFE: only "development" and "test" relax anything. Any other value — "production", "dev",
# "staging", a typo, or no value at all — is treated as production-like (schema auto-sync, SQL logging and
# Swagger are off, cookies are Secure, HSTS is sent). Use "development" on a developer machine only.
NODE_ENV=development
PORT=4000
API_PREFIX=api

# ── Database (MySQL) ─────────────────────────────────────────────────────────────────────────────
# Use a least-privilege application account (data changes only), never root. scripts/db/provision-db-users.sql
# creates one account for the running API and, separately, a schema-change account for migrations.
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=ccb_app
DB_PASSWORD=__SET_DB_PASSWORD__
DB_DATABASE=ccb

# Schema auto-sync and SQL logging exist ONLY on a developer machine (NODE_ENV=development, on by default
# there; set false to turn them off). Everywhere else they are off, and DB_SYNCHRONIZE=true is a startup error.
# DB_SYNCHRONIZE=false
# DB_LOGGING=false
# Run pending migrations when the API boots (default true). Set false where the runtime account is
# DML-only and a privileged account applies migrations with `npm run migration:run`.
# DB_MIGRATIONS_RUN=false
# The migration CLI (npm run migration:run / migration:revert) uses these instead when set, so the running
# API never needs schema-change rights. Falls back to DB_USERNAME / DB_PASSWORD when unset.
# DB_MIGRATION_USERNAME=ccb_migrator
# DB_MIGRATION_PASSWORD=__SET_MIGRATION_PASSWORD__

# ── Redis ────────────────────────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
ATTRIBUTE_CACHE_TTL_SECONDS=300

# ── Authentication ───────────────────────────────────────────────────────────────────────────────
# Signing key for every access token (staff and customer). At least 32 characters of random data, unique
# per environment:   openssl rand -base64 48
JWT_SECRET=__SET_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS__
JWT_EXPIRES_IN=15m
# How long a sign-in stays refreshable. Sliding: every refresh issues a token with a fresh full lifetime. Format: 30s, 15m, 1h, 7d.
REFRESH_TOKEN_EXPIRES_IN=7d
# The same, for a sign-in with "Remember me" ticked: a PERSISTENT session (its refresh cookie survives the browser being closed).
# Without the tick the cookie is a browser-session cookie and REFRESH_TOKEN_EXPIRES_IN applies. Never shorter than
# REFRESH_TOKEN_EXPIRES_IN. The access token is the same either way. Default 30d when unset.
# REFRESH_TOKEN_REMEMBER_ME_EXPIRES_IN=30d

# Refresh-token cookie (HttpOnly, scoped to /<API_PREFIX>/v1/auth). Secure defaults to true when
# NODE_ENV=production; SameSite defaults to lax. A cookie only reaches the API when the web app and the API
# are SAME-SITE (same registrable domain or one reverse proxy origin); for a cross-site deployment use HTTPS
# with COOKIE_SAMESITE=none (always Secure). Plain-http cross-origin setups cannot carry the cookie.
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=true
# COOKIE_DOMAIN=
# REFRESH_COOKIE_NAME=ccb_rt
# Compatibility only: also return the refresh token in the JSON body (older clients). Leave unset/false.
# AUTH_REFRESH_IN_BODY=false

# Brute-force protection on sign-in (counted per account AND per client IP, in a fixed window).
# LOGIN_MAX_FAILED_PER_ACCOUNT=10
# LOGIN_MAX_FAILED_PER_IP=20
# LOGIN_LOCK_MINUTES=15
# Request-rate limits per client IP: a generous default for every route, a strict one for sign-in, token
# refresh, customer activation, password change and the admin credential actions.
# THROTTLE_LIMIT=600
# THROTTLE_TTL_SECONDS=60
# THROTTLE_AUTH_LIMIT=10
# THROTTLE_AUTH_TTL_SECONDS=60

# ── HTTP surface ─────────────────────────────────────────────────────────────────────────────────
# Browser origins allowed to call the API, comma-separated, no wildcard (a "*" is rejected at startup).
# Nothing is allowed unless listed — except on a developer machine, where http://localhost:3000 and
# http://127.0.0.1:3000 are allowed by default. List every web origin of THIS environment explicitly.
# CORS_ORIGINS=https://app.example.com
# How many reverse-proxy hops to trust for X-Forwarded-For (a number, or "loopback" / a CIDR list).
# Unset = trust nobody, which is correct when clients reach the API directly. Set it behind a proxy so rate
# limiting and login history see the real client address.
# TRUST_PROXY=1
# Swagger UI and the OpenAPI JSON list every route: on by default on a developer machine only. Enable
# elsewhere deliberately.
# SWAGGER_ENABLED=false

# ── First-run administrator (only used when the database has no users at all) ────────────────────
# DEFAULT_ADMIN_PASSWORD is mandatory on a fresh database and must meet the password policy: at least 12
# characters and at most 72 bytes (UTF-8; bcrypt ignores anything longer), at least 3 of {uppercase, lowercase,
# number, symbol}, not one repeated character. The
# account is created with "must change password at first sign-in" set. Remove the value from the file once
# the first sign-in is done.
DEFAULT_ADMIN_NAME=System Administrator
DEFAULT_ADMIN_EMAIL=admin@ccb.local
DEFAULT_ADMIN_PASSWORD=__SET_A_STRONG_INITIAL_PASSWORD__

# ── Customer portal / activation ─────────────────────────────────────────────────────────────────
# Base URL of the customer-facing web app, used to build activation links.
CUSTOMER_PORTAL_URL=http://localhost:3000
ACTIVATION_TOKEN_EXPIRY=48h

# ── Integrations (third-party credentials: issue per environment, never reuse another environment's) ─
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
SFTP_PASSWORD=
SFTP_REMOTE_PATH=
SFTP_CRON_ENABLED=false

SSO_AUTHORIZATION_URL=
SSO_TOKEN_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_CALLBACK_URL=

CONVERSEZEN_BASE_URL=
CONVERSEZEN_API_KEY=
CONVERSEZEN_AGENT_EMIRATES_ID=
CONVERSEZEN_AGENT_PASSPORT=
CONVERSEZEN_AGENT_TRN=
CONVERSEZEN_AGENT_TRADE_LICENSE=
CONVERSEZEN_AGENT_RAG=
CONVERSEZEN_AGENT_TITLE_DEED=
CONVERSEZEN_AGENT_TENANCY_CONTRACT=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
