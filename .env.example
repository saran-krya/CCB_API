NODE_ENV=development
PORT=4000
API_PREFIX=api
DB_HOST=
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
JWT_SECRET=
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# ── Redis (Attribute cache-aside — see src/redis/redis.service.ts) ──────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# How long a cached attribute value lives before it expires on its own, in seconds.
ATTRIBUTE_CACHE_TTL_SECONDS=600

# ── Bootstrap / First-run seed ──────────────────────────────────────────────────
# These are used ONCE to create the initial Super Admin account on a fresh
# database. They are ignored on every subsequent startup (users table not empty).
# Change the password immediately after first login.
DEFAULT_ADMIN_NAME=
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
SFTP_PASSWORD=
SFTP_REMOTE_PATH=
SFTP_CRON_ENABLED=true

SSO_AUTHORIZATION_URL=
SSO_TOKEN_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_CALLBACK_URL=

# ── ConverseZen (OCR document extraction for Registration Requests) ─────────────
CONVERSEZEN_BASE_URL=
CONVERSEZEN_API_KEY=
CONVERSEZEN_AGENT_EMIRATES_ID=
CONVERSEZEN_AGENT_PASSPORT=
CONVERSEZEN_AGENT_TRN=
CONVERSEZEN_AGENT_TRADE_LICENSE=
CONVERSEZEN_AGENT_RAG=
CONVERSEZEN_AGENT_TITLE_DEED=
CONVERSEZEN_AGENT_TENANCY_CONTRACT=

# ── SMTP (Customer activation / Security Deposit payment emails) ────────────────
# Never commit real credentials — this file has no values on purpose.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# How long a customer's activation link stays valid before they must request a new one.
ACTIVATION_TOKEN_EXPIRY=48h

# Base URL of the customer-facing frontend (CCB_Web) — activation links point here, at
# /activate?token=... . No trailing slash.
CUSTOMER_PORTAL_URL=http://localhost:3000
